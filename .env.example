OATHCAST_HOST=0.0.0.0
OATHCAST_PORT=8080
OATHCAST_PROVIDER_ORDER=open_meteo
WEATHERAPI_KEY=
OPENWEATHER_API_KEY=
OATHCAST_MINER_API_KEY=
# Optional overlap during secret rotation; comma-separated, never commit values.
OATHCAST_MINER_API_KEYS=
OATHCAST_REQUIRE_AUTH=true
# Deliberately opt in to the unregistered Telegraph 2t temperature envelope.
# Leave false unless the reviewed compatibility release is being served.
OATHCAST_ENABLE_TEMPERATURE_WINDOW=false
OATHCAST_RECEIPT_DB=/data/oathcast/receipts.sqlite3
# Optional positive production caps; leave blank for the application defaults.
OATHCAST_RECEIPT_MAX_ROWS=
OATHCAST_RECEIPT_MAX_BYTES=
# Cache the real transactional SQLite readiness probe to limit lock contention.
OATHCAST_RECEIPT_WRITE_PROBE_INTERVAL_SECONDS=30
OATHCAST_RATE_LIMIT_PER_MINUTE=120
OATHCAST_AUTH_FAILURE_LIMIT_PER_MINUTE=20
# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For.
# Keep this narrow: every listed network can choose the client's rate-limit key.
OATHCAST_TRUSTED_PROXIES=
OATHCAST_RELEASE_ID=unreleased
OATHCAST_SOURCE_SHA256=unrecorded
OATHCAST_IMAGE_DIGEST=unrecorded
OATHCAST_PUBLIC_URL=https://oathcastcourt.duckdns.org
OATHCAST_DEMAND_DB=state/demand.sqlite3

# Current Telegraph dispatcher / Solana-devnet x402 canary
OATHCAST_DISPATCHER_URL=http://13.237.89.59:7044/miner-dispatcher
TELEGRAPH_DISPATCHER_URL=http://13.237.89.59:7044/miner-dispatcher
SOLANA_RPC_URL=https://api.devnet.solana.com
# Never commit a value. payment-canary reads this only with explicit --execute.
SOLANA_PRIVATE_KEY=
OATHCAST_MAX_PAYMENT_MICRO_USDC=10000
OATHCAST_MAX_TOTAL_PAYMENT_MICRO_USDC=10000
OATHCAST_EXPECTED_PAY_TO=
# Application-side only; never place a payment journal in the Miner container.
# This path is illustrative; the current library accepts the journal path from code.
OATHCAST_PAYMENT_JOURNAL=/var/lib/oathcast/application/payment-journal.sqlite3

# Track 3 private Application path (disabled unless explicitly enabled).
# The TypeScript sidecar owns SOLANA_PRIVATE_KEY and the payment journal; the
# Python gateway receives only its bounded, sanitized result over this socket.
OATHCAST_APPLICATION_ENABLE_PAID=false
OATHCAST_APPLICATION_SOCKET=/var/run/oathcast/application-payment.sock
OATHCAST_APPLICATION_PAYMENT_JOURNAL=/var/lib/oathcast/application/payment-journal.sqlite3
OATHCAST_APPLICATION_SIDECAR_TOKEN=
OATHCAST_APPLICATION_TOKEN=
OATHCAST_APPLICATION_ALLOWED_MINER_IDS=212
OATHCAST_APPLICATION_ALLOWED_ENDPOINTS=forecast
OATHCAST_APPLICATION_MAX_REQUESTS=1
OATHCAST_APPLICATION_ALLOW_INSECURE_HTTP_DEVNET=false
OATHCAST_APPLICATION_REGISTRY_SNAPSHOT_SHA256=
OATHCAST_APPLICATION_HOST=127.0.0.1
OATHCAST_APPLICATION_PORT=8790
OATHCAST_APPLICATION_CASE_DB=state/application.sqlite3

# Legacy EVM compatibility examples only; current payment code does not read them.
OATHCAST_PAYMENT_NETWORK=eip155:84532
OATHCAST_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Railway and similar hosts usually provide PORT; OATHCAST_PORT takes precedence.
PORT=8080
